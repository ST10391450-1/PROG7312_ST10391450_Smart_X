
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Smart_X_UI.Models"
    x:Class="Smart_X_UI.Pages.SensorDashboard">

    <UserControl.Styles>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2D8CFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>

        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#4098FF"/>
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#172B3B"/>
            <Setter Property="Foreground" Value="#D8E6F3"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>

        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="#203B50"/>
        </Style>

        <Style Selector="Button.details">
            <Setter Property="Background" Value="#182C3D"/>
            <Setter Property="Foreground" Value="#8FC5FF"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style Selector="Button.back">
            <Setter Property="Background" Value="#122536"/>
            <Setter Property="Foreground" Value="#B9CAD6"/>
            <Setter Property="BorderBrush" Value="#29465D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>

        <Style Selector="Border.stat-card">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <Style Selector="Border.sensor-card">
            <Setter Property="Background" Value="#111F2C"/>
            <Setter Property="BorderBrush" Value="#294257"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style Selector="TextBox.search-box">
            <Setter Property="Background" Value="#101F2D"/>
            <Setter Property="Foreground" Value="#EDF4F8"/>
            <Setter Property="BorderBrush" Value="#294257"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="42"/>
        </Style>

        <Style Selector="ComboBox.filter-box">
            <Setter Property="Background" Value="#172B3B"/>
            <Setter Property="Foreground" Value="#D8E6F3"/>
            <Setter Property="BorderBrush" Value="#294257"/>
            <Setter Property="MinHeight" Value="42"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" Background="#0A151F">

        <Border
            Grid.Row="0"
            Background="#0F1D29"
            BorderBrush="#1D3446"
            BorderThickness="0,0,0,1"
            Padding="20,15">

            <StackPanel Spacing="14">

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="15">

                    <Button
                        Grid.Column="0"
                        Content="←  Main Window"
                        Classes="back"
                        Click="BackButton_Click"
                        VerticalAlignment="Center"/>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="3">

                        <TextBlock
                            Text="SENSOR DASHBOARD"
                            FontSize="21"
                            FontWeight="Bold"
                            Foreground="#F1F6FA"/>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="7">

                            <Ellipse
                                Width="7"
                                Height="7"
                                Fill="#39D98A"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                x:Name="ConnectionStatusText"
                                Text="CONNECTING..."
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#8FA8BC"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <TextBlock
                    x:Name="StatusText"
                    Text="Loading sensors..."
                    FontSize="11"
                    Foreground="#6F879A"
                    TextTrimming="CharacterEllipsis"/>

                <WrapPanel Orientation="Horizontal">

                    <Button
                        Content="↻  Refresh"
                        Classes="secondary"
                        Click="RefreshButton_Click"
                        Margin="0,0,7,7"/>

                    <Button
                        Content="+  Add Location"
                        Classes="secondary"
                        Click="AddLocationButton_Click"
                        Margin="0,0,7,7"/>

                    <Button
                        Content="Manage Categories"
                        Classes="secondary"
                        Click="ManageCategoriesButton_Click"
                        Margin="0,0,7,7"/>

                    <Button
                        Content="+  Add Sensor"
                        Classes="primary"
                        Click="AddSensorButton_Click"
                        Margin="0,0,7,7"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <ScrollViewer
            Grid.Row="1"
            Padding="20"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel Spacing="22">

                <Grid
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="10">

                    <Border
                        Classes="stat-card"
                        Background="#14293A"
                        BorderBrush="#28516E"
                        CornerRadius="7">

                        <StackPanel Spacing="7">

                            <TextBlock
                                Text="REGISTERED"
                                FontSize="9"
                                FontWeight="SemiBold"
                                Foreground="#71899D"/>

                            <TextBlock
                                x:Name="RegisteredSensorsText"
                                Text="0"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="#F1F6FA"/>

                            <TextBlock
                                Text="Total devices"
                                FontSize="9"
                                Foreground="#71899D"/>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Classes="stat-card"
                        Background="#142A24"
                        BorderBrush="#285143"
                        CornerRadius="7">

                        <StackPanel Spacing="7">

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="6">

                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    Fill="#39D98A"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Text="ACTIVE"
                                    FontSize="9"
                                    FontWeight="SemiBold"
                                    Foreground="#6E9D92"/>
                            </StackPanel>

                            <TextBlock
                                x:Name="ActiveSensorsText"
                                Text="0"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="#E8FFF4"/>

                            <TextBlock
                                Text="Currently online"
                                FontSize="9"
                                Foreground="#71968C"/>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="2"
                        Classes="stat-card"
                        Background="#2A211B"
                        BorderBrush="#4A3829"
                        CornerRadius="7">

                        <StackPanel Spacing="7">

                            <TextBlock
                                Text="ISSUES"
                                FontSize="9"
                                FontWeight="SemiBold"
                                Foreground="#A58A6D"/>

                            <TextBlock
                                x:Name="IssuesText"
                                Text="0"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="#FFF2E5"/>

                            <TextBlock
                                Text="Requires attention"
                                FontSize="9"
                                Foreground="#9A8066"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Spacing="4">

                    <TextBlock
                        Text="REGISTERED SENSORS"
                        FontSize="19"
                        FontWeight="Bold"
                        Foreground="#F1F6FA"/>

                    <TextBlock
                        Text="Search, filter and monitor registered Smart X devices."
                        FontSize="11"
                        Foreground="#70889B"/>
                </StackPanel>

                <Border
                    Background="#0F1D29"
                    BorderBrush="#1E3548"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="15">

                    <StackPanel Spacing="12">

                        <TextBlock
                            Text="SEARCH AND FILTERS"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="#C8D7E2"/>

                        <TextBox
                            x:Name="SensorSearchBox"
                            Classes="search-box"
                            Watermark="Search device ID, location or category..."
                            HorizontalAlignment="Stretch"/>

                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="10">

                            <StackPanel Spacing="5">

                                <TextBlock
                                    Text="CATEGORY"
                                    FontSize="9"
                                    FontWeight="SemiBold"
                                    Foreground="#71899D"/>

                                <ComboBox
                                    x:Name="CategoryFilter"
                                    Classes="filter-box"
                                    HorizontalAlignment="Stretch"
                                    SelectedIndex="0">

                                    <ComboBoxItem Content="All categories"/>
                                    <ComboBoxItem Content="Environmental"/>
                                    <ComboBoxItem Content="Power"/>
                                    <ComboBoxItem Content="Actuator"/>
                                    <ComboBoxItem Content="Other"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                Spacing="5">

                                <TextBlock
                                    Text="CONNECTION STATUS"
                                    FontSize="9"
                                    FontWeight="SemiBold"
                                    Foreground="#71899D"/>

                                <ComboBox
                                    x:Name="StatusFilter"
                                    Classes="filter-box"
                                    HorizontalAlignment="Stretch"
                                    SelectedIndex="0">

                                    <ComboBoxItem Content="All statuses"/>
                                    <ComboBoxItem Content="Online"/>
                                    <ComboBoxItem Content="Offline"/>
                                    <ComboBoxItem Content="Issue"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Text="Search by device ID, location or category."
                            FontSize="10"
                            Foreground="#60788B"
                            TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border
                    Background="#0F1D29"
                    BorderBrush="#1E3548"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="18">

                    <StackPanel Spacing="18">

                        <Grid ColumnDefinitions="*,Auto">

                            <StackPanel Spacing="3">

                                <TextBlock
                                    Text="NETWORK OVERVIEW"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Foreground="#EAF2F7"/>

                                <TextBlock
                                    Text="Current state of the Smart X network"
                                    FontSize="10"
                                    Foreground="#6C8497"/>
                            </StackPanel>

                            <TextBlock
                                Grid.Column="1"
                                Text="LIVE DATA"
                                FontSize="9"
                                FontWeight="Bold"
                                Foreground="#4FBF91"
                                VerticalAlignment="Center"/>
                        </Grid>

                        <Grid
                            ColumnDefinitions="*,*"
                            ColumnSpacing="10">

                            <Border
                                Background="#162535"
                                BorderBrush="#20394E"
                                BorderThickness="0,0,0,1"
                                CornerRadius="5"
                                Padding="13">

                                <StackPanel Spacing="6">

                                    <TextBlock
                                        Text="AVERAGE TEMPERATURE"
                                        FontSize="9"
                                        FontWeight="SemiBold"
                                        Foreground="#71899D"
                                        TextWrapping="Wrap"/>

                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="5">

                                        <TextBlock
                                            x:Name="AverageTemperatureText"
                                            Text="--"
                                            FontSize="25"
                                            FontWeight="Bold"
                                            Foreground="#F1F6FA"/>

                                        <TextBlock
                                            Text="°C"
                                            FontSize="12"
                                            Foreground="#8FC5FF"
                                            VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock
                                        x:Name="TemperatureStatusText"
                                        Text="No readings"
                                        FontSize="9"
                                        Foreground="#60788B"
                                        TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Column="1"
                                Background="#252317"
                                BorderBrush="#403A23"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="13">

                                <StackPanel Spacing="6">

                                    <TextBlock
                                        Text="TOTAL POWER"
                                        FontSize="9"
                                        FontWeight="SemiBold"
                                        Foreground="#A99B62"/>

                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="5">

                                        <TextBlock
                                            x:Name="TotalPowerText"
                                            Text="--"
                                            FontSize="25"
                                            FontWeight="Bold"
                                            Foreground="#F5EBCB"/>

                                        <TextBlock
                                            Text="W"
                                            FontSize="12"
                                            Foreground="#8FC5FF"
                                            VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <TextBlock
                                        x:Name="PowerStatusText"
                                        Text="No readings"
                                        FontSize="9"
                                        Foreground="#827951"
                                        TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border
                            Background="#142A25"
                            BorderBrush="#285143"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="13">

                            <StackPanel Spacing="5">

                                <TextBlock
                                    Text="NETWORK CONNECTIONS"
                                    FontSize="9"
                                    FontWeight="SemiBold"
                                    Foreground="#719B91"/>

                                <StackPanel
                                    Orientation="Horizontal"
                                    Spacing="5">

                                    <TextBlock
                                        x:Name="NetworkActiveText"
                                        Text="0"
                                        FontSize="24"
                                        FontWeight="Bold"
                                        Foreground="#39D98A"/>

                                    <TextBlock
                                        Text="active"
                                        FontSize="11"
                                        Foreground="#7FA197"
                                        VerticalAlignment="Center"/>
                                </StackPanel>

                                <TextBlock
                                    x:Name="NetworkStatusText"
                                    Text="Waiting for sensors"
                                    FontSize="10"
                                    Foreground="#64837A"
                                    TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Grid
                            ColumnDefinitions="*,*,*"
                            ColumnSpacing="10">

                            <StackPanel Spacing="5">

                                <TextBlock
                                    Text="ENVIRONMENTAL"
                                    FontSize="9"
                                    FontWeight="SemiBold"
                                    Foreground="#6E9D92"
                                    TextWrapping="Wrap"/>

                                <TextBlock
                                    x:Name="EnvironmentalSensorsText"
                                    Text="0 sensors"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#D9F3ED"
                                    TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                Spacing="5">

                                <TextBlock
                                    Text="POWER"
                                    FontSize="9"
                                    FontWeight="SemiBold"
                                    Foreground="#A99B62"/>

                                <TextBlock
                                    x:Name="PowerSensorsText"
                                    Text="0 sensors"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#F0E8C8"
                                    TextWrapping="Wrap"/>

                                <TextBlock
                                    Text="Energy monitoring"
                                    FontSize="9"
                                    Foreground="#847B56"
                                    TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                Spacing="5">

                                <TextBlock
                                    Text="ACTUATORS"
                                    FontSize="9"
                                    FontWeight="SemiBold"
                                    Foreground="#9D7DB5"
                                    TextWrapping="Wrap"/>

                                <TextBlock
                                    x:Name="ActuatorSensorsText"
                                    Text="0 sensors"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="#E9DCF0"
                                    TextWrapping="Wrap"/>

                                <TextBlock
                                    Text="Control devices"
                                    FontSize="9"
                                    Foreground="#776183"
                                    TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>

                        <Border
                            Background="#101F2D"
                            BorderBrush="#1C3447"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="12">

                            <StackPanel Spacing="5">

                                <TextBlock
                                    Text="LATEST ACTIVITY"
                                    FontSize="8"
                                    FontWeight="SemiBold"
                                    Foreground="#637C8F"/>

                                <TextBlock
                                    x:Name="LatestSensorActivityText"
                                    Text="Waiting for sensor telemetry..."
                                    FontSize="11"
                                    Foreground="#B9CAD6"
                                    TextWrapping="Wrap"/>

                                <TextBlock
                                    x:Name="LastUpdateText"
                                    Text="Last update: --"
                                    FontSize="9"
                                    Foreground="#637C8F"
                                    TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="4">

                    <TextBlock
                        Text="DEVICES"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#C8D7E2"/>

                    <TextBlock
                        Text="Registered hardware and latest readings"
                        FontSize="10"
                        Foreground="#60788B"/>
                </StackPanel>

                <ItemsControl x:Name="SensorsItemsControl">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:SensorRegistration">

                            <Border
                                Classes="sensor-card"
                                Margin="0,0,0,10">

                                <StackPanel Spacing="14">

                                    <Grid
                                        ColumnDefinitions="*,Auto"
                                        ColumnSpacing="10">

                                        <StackPanel Spacing="4">

                                            <TextBlock
                                                Text="DEVICE"
                                                FontSize="8"
                                                FontWeight="SemiBold"
                                                Foreground="#637C8F"/>

                                            <TextBlock
                                                Text="{Binding NodeId}"
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Foreground="#EDF4F8"
                                                TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="1"
                                            Spacing="8"
                                            HorizontalAlignment="Right">

                                            <Border
                                                Background="#0D1A25"
                                                CornerRadius="10"
                                                Padding="8,4"
                                                HorizontalAlignment="Right">

                                                <StackPanel
                                                    Orientation="Horizontal"
                                                    Spacing="5">

                                                    <Ellipse
                                                        Width="6"
                                                        Height="6"
                                                        Fill="{Binding StatusColor}"
                                                        VerticalAlignment="Center"/>

                                                    <TextBlock
                                                        Text="{Binding StatusText}"
                                                        FontSize="9"
                                                        FontWeight="SemiBold"
                                                        Foreground="{Binding StatusColor}"/>
                                                </StackPanel>
                                            </Border>

                                            <Button
                                                Content="Details →"
                                                Classes="details"
                                                Tag="{Binding}"
                                                Click="SensorDetailsButton_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border
                                        Background="#0D1A25"
                                        BorderBrush="#1C3447"
                                        BorderThickness="1"
                                        Padding="12"
                                        CornerRadius="5">

                                        <StackPanel Spacing="7">

                                            <TextBlock
                                                Text="LATEST READING"
                                                FontSize="8"
                                                FontWeight="SemiBold"
                                                Foreground="#637C8F"/>

                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="5">

                                                <TextBlock
                                                    Text="{Binding CurrentDataText}"
                                                    FontSize="20"
                                                    FontWeight="Bold"
                                                    Foreground="#F1F6FA"
                                                    TextWrapping="Wrap"/>

                                                <TextBlock
                                                    Text="{Binding Unit}"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="#8FC5FF"
                                                    VerticalAlignment="Center"
                                                    TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <TextBlock
                                                Text="{Binding CurrentDataTimestampText}"
                                                FontSize="9"
                                                Foreground="#637C8F"
                                                TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Grid
                                        ColumnDefinitions="*,*"
                                        ColumnSpacing="12">

                                        <StackPanel Spacing="4">

                                            <TextBlock
                                                Text="LOCATION"
                                                FontSize="8"
                                                FontWeight="SemiBold"
                                                Foreground="#637C8F"/>

                                            <TextBlock
                                                Text="{Binding Location}"
                                                FontSize="11"
                                                Foreground="#B9CAD6"
                                                TextWrapping="Wrap"/>
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="1"
                                            Spacing="4">

                                            <TextBlock
                                                Text="CATEGORY"
                                                FontSize="8"
                                                FontWeight="SemiBold"
                                                Foreground="#637C8F"/>

                                            <TextBlock
                                                Text="{Binding Category}"
                                                FontSize="11"
                                                Foreground="#B9CAD6"
                                                TextWrapping="Wrap"/>

                                            <TextBlock
                                                Text="{Binding Unit}"
                                                FontSize="10"
                                                Foreground="#8FC5FF"
                                                TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
