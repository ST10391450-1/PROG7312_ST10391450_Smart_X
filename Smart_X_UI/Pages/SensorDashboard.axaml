<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Smart_X_UI.Models"
    x:Class="Smart_X_UI.Pages.SensorDashboard">

    <UserControl.Styles>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2D8CFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>

        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#4098FF"/>
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#172B3B"/>
            <Setter Property="Foreground" Value="#D8E6F3"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>

        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="#203B50"/>
        </Style>

        <Style Selector="Button.details">
            <Setter Property="Background" Value="#182C3D"/>
            <Setter Property="Foreground" Value="#8FC5FF"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <Style Selector="Button.details:pointerover">
            <Setter Property="Background" Value="#24435A"/>
        </Style>

        <Style Selector="Button.back">
            <Setter Property="Background" Value="#122536"/>
            <Setter Property="Foreground" Value="#B9CAD6"/>
            <Setter Property="BorderBrush" Value="#29465D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>

        <Style Selector="Button.back:pointerover">
            <Setter Property="Background" Value="#1D3A50"/>
            <Setter Property="BorderBrush" Value="#4A7190"/>
        </Style>

        <Style Selector="Border.stat-card">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <Style Selector="Border.sensor-card">
            <Setter Property="Background" Value="#111F2C"/>
            <Setter Property="BorderBrush" Value="#294257"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

    </UserControl.Styles>

    <Grid
        RowDefinitions="Auto,*"
        Background="#0A151F">

        <Border
            Grid.Row="0"
            Background="#0F1D29"
            BorderBrush="#1D3446"
            BorderThickness="0,0,0,1"
            Padding="20,15">

            <Grid RowDefinitions="Auto,Auto">

                <Grid
                    Grid.Row="0"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="15">

                    <Button
                        Grid.Column="0"
                        Content="←  Main Window"
                        Classes="back"
                        Click="BackButton_Click"
                        VerticalAlignment="Center"/>

                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2">

                        <TextBlock
                            Text="SENSOR DASHBOARD"
                            FontSize="21"
                            FontWeight="Bold"
                            Foreground="#F1F6FA"/>

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="7">

                            <Ellipse
                                Width="7"
                                Height="7"
                                Fill="#39D98A"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                x:Name="ConnectionStatusText"
                                Text="CONNECTING..."
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="#8FA8BC"/>

                        </StackPanel>

                    </StackPanel>

                </Grid>

                <Grid
                    Grid.Row="1"
                    Margin="0,14,0,0"
                    ColumnDefinitions="*,Auto">

                    <TextBlock
                        x:Name="StatusText"
                        Text="Loading sensors..."
                        FontSize="11"
                        Foreground="#6F879A"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis"/>

                    <WrapPanel
                        Grid.Column="1"
                        Orientation="Horizontal">

                        <Button
                            Content="↻  Refresh"
                            Classes="secondary"
                            Click="RefreshButton_Click"
                            Margin="0,0,7,0"/>

                        <Button
                            Content="+  Add Location"
                            Classes="secondary"
                            Click="AddLocationButton_Click"
                            Margin="0,0,7,0"/>

                        <Button
                            Content="+  Add Sensor"
                            Classes="primary"
                            Click="AddSensorButton_Click"/>

                    </WrapPanel>

                </Grid>

            </Grid>

        </Border>

        <ScrollViewer
            Grid.Row="1"
            Padding="20"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">

            <StackPanel Spacing="24">

                <Grid
                    ColumnDefinitions="1.3*,1*,0.9*"
                    ColumnSpacing="10">

                    <Border
                        Classes="stat-card"
                        Background="#14293A"
                        BorderBrush="#28516E"
                        CornerRadius="3">

                        <Grid
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,*">

                            <TextBlock
                                Text="REGISTERED"
                                FontSize="9"
                                FontWeight="SemiBold"
                                Foreground="#71899D"/>

                            <TextBlock
                                Grid.Column="1"
                                Text="TOTAL"
                                FontSize="8"
                                Foreground="#50697C"/>

                            <TextBlock
                                Grid.Row="1"
                                Text="0"
                                x:Name="RegisteredSensorsText"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="#F1F6FA"
                                Margin="0,8,0,0"/>

                        </Grid>

                    </Border>

                    <Border
                        Grid.Column="1"
                        Classes="stat-card"
                        Background="#142A24"
                        BorderBrush="#285143"
                        CornerRadius="12,3,12,3"
                        Padding="17,13">

                        <StackPanel Spacing="5">

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="6">

                                <Ellipse
                                    Width="6"
                                    Height="6"
                                    Fill="#39D98A"
                                    VerticalAlignment="Center"/>

                                <TextBlock
                                    Text="ACTIVE"
                                    FontSize="9"
                                    FontWeight="SemiBold"
                                    Foreground="#6E9D92"/>

                            </StackPanel>

                            <TextBlock
                                x:Name="ActiveSensorsText"
                                Text="0"
                                FontSize="27"
                                FontWeight="Bold"
                                Foreground="#E8FFF4"/>

                            <TextBlock
                                Text="Currently online"
                                FontSize="9"
                                Foreground="#71968C"/>

                        </StackPanel>

                    </Border>

                    <Border
                        Grid.Column="2"
                        Classes="stat-card"
                        Background="#2A211B"
                        BorderBrush="#4A3829"
                        CornerRadius="3,12,3,12"
                        Padding="15">

                        <StackPanel>

                            <TextBlock
                                Text="ISSUES"
                                FontSize="9"
                                FontWeight="SemiBold"
                                Foreground="#A58A6D"/>

                            <TextBlock
                                x:Name="IssuesText"
                                Text="0"
                                FontSize="29"
                                FontWeight="Bold"
                                Foreground="#FFF2E5"
                                Margin="0,5,0,0"/>

                            <TextBlock
                                Text="Requires attention"
                                FontSize="9"
                                Foreground="#9A8066"
                                Margin="0,2,0,0"/>

                        </StackPanel>

                    </Border>

                </Grid>

                <Grid
                    ColumnDefinitions="*,Auto"
                    Margin="0,3,0,0">

                    <StackPanel>

                        <TextBlock
                            Text="REGISTERED SENSORS"
                            FontSize="19"
                            FontWeight="Bold"
                            Foreground="#F1F6FA"/>

                        <TextBlock
                            Text="Monitor connected Smart X devices"
                            FontSize="11"
                            Foreground="#70889B"
                            Margin="0,3,0,0"/>

                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Background="#142A24"
                        CornerRadius="12"
                        Padding="10,5"
                        VerticalAlignment="Center">

                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="5">

                            <Ellipse
                                Width="6"
                                Height="6"
                                Fill="#39D98A"
                                VerticalAlignment="Center"/>

                            <TextBlock
                                Text="LIVE"
                                FontSize="9"
                                FontWeight="Bold"
                                Foreground="#39D98A"/>

                        </StackPanel>

                    </Border>

                </Grid>

                <Border
                    Background="#0F1D29"
                    BorderBrush="#1E3548"
                    BorderThickness="1,1,1,3"
                    CornerRadius="9"
                    Padding="18,16">

                    <StackPanel Spacing="18">

                        <Grid
                            ColumnDefinitions="*,Auto">

                            <StackPanel>

                                <TextBlock
                                    Text="NETWORK OVERVIEW"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Foreground="#EAF2F7"/>

                                <TextBlock
                                    Text="Current state of the Smart X network"
                                    FontSize="10"
                                    Foreground="#6C8497"
                                    Margin="0,3,0,0"/>

                            </StackPanel>

                            <TextBlock
                                Grid.Column="1"
                                Text="LIVE DATA"
                                FontSize="9"
                                FontWeight="Bold"
                                Foreground="#4FBF91"
                                VerticalAlignment="Center"/>

                        </Grid>

                        <Grid
                            ColumnDefinitions="1.2*,0.9*,1*"
                            ColumnSpacing="10">

                            <Border
                                Background="#162535"
                                BorderBrush="#20394E"
                                BorderThickness="0,0,0,1"
                                CornerRadius="3"
                                Padding="13,15">

                                <StackPanel>

                                    <TextBlock
                                        Text="TEMPERATURE"
                                        FontSize="9"
                                        FontWeight="SemiBold"
                                        Foreground="#71899D"/>

                                    <StackPanel
                                        Orientation="Horizontal"
                                        Margin="0,6,0,2">

                                        <TextBlock
                                            x:Name="AverageTemperatureText"
                                            Text="--"
                                            FontSize="25"
                                            FontWeight="Bold"
                                            Foreground="#F1F6FA"/>

                                        <TextBlock
                                            Text="°C"
                                            FontSize="11"
                                            Foreground="#8299AA"
                                            VerticalAlignment="Bottom"
                                            Margin="4,0,0,4"/>

                                    </StackPanel>

                                    <TextBlock
                                        x:Name="TemperatureStatusText"
                                        Text="No readings"
                                        FontSize="9"
                                        Foreground="#60788B"/>

                                </StackPanel>

                            </Border>

                            <Border
                                Grid.Column="1"
                                Background="#252317"
                                BorderBrush="#403A23"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="13">

                                <StackPanel>

                                    <TextBlock
                                        Text="POWER"
                                        FontSize="9"
                                        FontWeight="SemiBold"
                                        Foreground="#A99B62"/>

                                    <StackPanel
                                        Orientation="Horizontal"
                                        Margin="0,6,0,2">

                                        <TextBlock
                                            x:Name="TotalPowerText"
                                            Text="--"
                                            FontSize="25"
                                            FontWeight="Bold"
                                            Foreground="#F5EBCB"/>

                                        <TextBlock
                                            Text="W"
                                            FontSize="11"
                                            Foreground="#A99B62"
                                            VerticalAlignment="Bottom"
                                            Margin="4,0,0,4"/>

                                    </StackPanel>

                                    <TextBlock
                                        x:Name="PowerStatusText"
                                        Text="No readings"
                                        FontSize="9"
                                        Foreground="#827951"/>

                                </StackPanel>

                            </Border>

                            <Border
                                Grid.Column="2"
                                Background="#142A25"
                                BorderBrush="#285143"
                                BorderThickness="0,1,0,0"
                                CornerRadius="4"
                                Padding="13">

                                <StackPanel>

                                    <TextBlock
                                        Text="NETWORK"
                                        FontSize="9"
                                        FontWeight="SemiBold"
                                        Foreground="#719B91"/>

                                    <StackPanel
                                        Orientation="Horizontal"
                                        Margin="0,6,0,2">

                                        <TextBlock
                                            x:Name="NetworkActiveText"
                                            Text="0"
                                            FontSize="25"
                                            FontWeight="Bold"
                                            Foreground="#39D98A"/>

                                        <TextBlock
                                            Text=" active"
                                            FontSize="11"
                                            Foreground="#7FA197"
                                            VerticalAlignment="Bottom"
                                            Margin="2,0,0,4"/>

                                    </StackPanel>

                                    <TextBlock
                                        x:Name="NetworkStatusText"
                                        Text="Waiting for sensors"
                                        FontSize="9"
                                        Foreground="#64837A"
                                        TextTrimming="CharacterEllipsis"/>

                                </StackPanel>

                            </Border>

                        </Grid>

                        <Grid
                            ColumnDefinitions="*,*,*"
                            ColumnSpacing="22">

                            <StackPanel>

                                <TextBlock
                                    Text="ENVIRONMENTAL"
                                    FontSize="9"
                                    FontWeight="SemiBold"
                                    Foreground="#6E9D92"/>

                                <TextBlock
                                    x:Name="EnvironmentalSensorsText"
                                    Text="0 sensors"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="#D9F3ED"
                                    Margin="0,4,0,0"/>

                                <Border
                                    Height="2"
                                    Background="#285143"
                                    Margin="0,5,25,0"/>

                            </StackPanel>

                            <StackPanel
                                Grid.Column="1">

                                <TextBlock
                                    Text="POWER"
                                    FontSize="9"
                                    FontWeight="SemiBold"
                                    Foreground="#A99B62"/>

                                <TextBlock
                                    x:Name="PowerSensorsText"
                                    Text="0 sensors"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="#F0E8C8"
                                    Margin="0,4,0,0"/>

                                <TextBlock
                                    Text="Energy monitoring"
                                    FontSize="9"
                                    Foreground="#847B56"
                                    Margin="0,4,0,0"/>

                            </StackPanel>

                            <StackPanel
                                Grid.Column="2">

                                <TextBlock
                                    Text="ACTUATORS"
                                    FontSize="9"
                                    FontWeight="SemiBold"
                                    Foreground="#9D7DB5"/>

                                <TextBlock
                                    x:Name="ActuatorSensorsText"
                                    Text="0 sensors"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="#E9DCF0"
                                    Margin="0,4,0,0"/>

                                <TextBlock
                                    Text="Control devices"
                                    FontSize="9"
                                    Foreground="#776183"
                                    Margin="0,4,0,0"/>

                            </StackPanel>

                        </Grid>

                        <Border
                            Background="#101F2D"
                            BorderBrush="#1C3447"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="12">

                            <Grid
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="15">

                                <StackPanel>

                                    <TextBlock
                                        Text="LATEST ACTIVITY"
                                        FontSize="8"
                                        FontWeight="SemiBold"
                                        Foreground="#637C8F"/>

                                    <TextBlock
                                        x:Name="LatestSensorActivityText"
                                        Text="Waiting for sensor telemetry..."
                                        FontSize="11"
                                        Foreground="#B9CAD6"
                                        Margin="0,3,0,0"
                                        TextTrimming="CharacterEllipsis"/>

                                </StackPanel>

                                <TextBlock
                                    Grid.Column="1"
                                    x:Name="LastUpdateText"
                                    Text="--"
                                    FontSize="9"
                                    Foreground="#637C8F"
                                    VerticalAlignment="Center"/>

                            </Grid>

                        </Border>

                    </StackPanel>

                </Border>

                <Grid
                    ColumnDefinitions="*,Auto"
                    Margin="0,4,0,0">

                    <TextBlock
                        Text="DEVICES"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="#C8D7E2"/>

                    <TextBlock
                        Grid.Column="1"
                        Text="CONNECTED HARDWARE"
                        FontSize="8"
                        FontWeight="SemiBold"
                        Foreground="#50697C"
                        VerticalAlignment="Center"/>

                </Grid>

                <ItemsControl
                    x:Name="SensorsItemsControl">

                    <ItemsControl.ItemTemplate>

                        <DataTemplate
                            x:DataType="models:SensorRegistration">

                            <Border
                                Classes="sensor-card"
                                Margin="0,0,0,10">

                                <Grid
                                    RowDefinitions="Auto,Auto,Auto"
                                    ColumnDefinitions="*,Auto"
                                    RowSpacing="14"
                                    ColumnSpacing="12">

                                    <StackPanel
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Spacing="3">

                                        <TextBlock
                                            Text="DEVICE"
                                            FontSize="8"
                                            FontWeight="SemiBold"
                                            Foreground="#637C8F"/>

                                        <TextBlock
                                            Text="{Binding NodeId}"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="#EDF4F8"
                                            TextTrimming="CharacterEllipsis"/>

                                    </StackPanel>

                                    <StackPanel
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">

                                        <Border
                                            Background="#0D1A25"
                                            CornerRadius="10"
                                            Padding="8,4">

                                            <StackPanel
                                                Orientation="Horizontal"
                                                Spacing="5">

                                                <Ellipse
                                                    Width="6"
                                                    Height="6"
                                                    Fill="{Binding StatusColor}"
                                                    VerticalAlignment="Center"/>

                                                <TextBlock
                                                    Text="{Binding StatusText}"
                                                    FontSize="9"
                                                    FontWeight="SemiBold"
                                                    Foreground="{Binding StatusColor}"/>

                                            </StackPanel>

                                        </Border>

                                        <Button
                                            Content="Details →"
                                            Classes="details"
                                            Tag="{Binding}"
                                            Click="SensorDetailsButton_Click"/>

                                    </StackPanel>

                                    <Border
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        Background="#0D1A25"
                                        Padding="12"
                                        CornerRadius="2">

                                        <Grid
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="15">

                                            <StackPanel>

                                                <TextBlock
                                                    Text="CURRENT DATA"
                                                    FontSize="8"
                                                    FontWeight="SemiBold"
                                                    Foreground="#637C8F"/>

                                                <TextBlock
                                                    Text="{Binding CurrentDataText}"
                                                    FontSize="18"
                                                    FontWeight="Bold"
                                                    Foreground="#F1F6FA"
                                                    Margin="0,3,0,0"
                                                    TextTrimming="CharacterEllipsis"/>

                                            </StackPanel>

                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding CurrentDataTimestampText}"
                                                FontSize="9"
                                                Foreground="#637C8F"
                                                VerticalAlignment="Center"/>

                                        </Grid>

                                    </Border>

                                    <Grid
                                        Grid.Row="2"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="2"
                                        ColumnDefinitions="*,*"
                                        ColumnSpacing="30">

                                        <StackPanel>

                                            <TextBlock
                                                Text="LOCATION"
                                                FontSize="8"
                                                FontWeight="SemiBold"
                                                Foreground="#637C8F"/>

                                            <TextBlock
                                                Text="{Binding Location}"
                                                FontSize="11"
                                                Foreground="#B9CAD6"
                                                Margin="0,3,0,0"
                                                TextWrapping="Wrap"/>

                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="1">

                                            <TextBlock
                                                Text="CATEGORY"
                                                FontSize="8"
                                                FontWeight="SemiBold"
                                                Foreground="#637C8F"/>

                                            <TextBlock
                                                Text="{Binding Category}"
                                                FontSize="11"
                                                Foreground="#B9CAD6"
                                                Margin="0,3,0,0"
                                                TextWrapping="Wrap"/>

                                        </StackPanel>

                                    </Grid>

                                </Grid>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>