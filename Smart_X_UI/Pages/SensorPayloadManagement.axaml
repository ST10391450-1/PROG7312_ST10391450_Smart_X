<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:Smart_X_UI.Models"
    x:Class="Smart_X_UI.Pages.SensorPayloadManagement">

    <UserControl.Styles>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#101F2D"/>
            <Setter Property="Foreground" Value="#E8F0F5"/>
            <Setter Property="BorderBrush" Value="#263E50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="#35C978"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#101F2D"/>
            <Setter Property="Foreground" Value="#E8F0F5"/>
            <Setter Property="BorderBrush" Value="#263E50"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style Selector="Button.primaryButton">
            <Setter Property="Background" Value="#207A4A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Button.primaryButton:pointerover">
            <Setter Property="Background" Value="#2A9660"/>
        </Style>

        <Style Selector="Button.primaryButton:pressed">
            <Setter Property="Background" Value="#185F3A"/>
        </Style>

        <Style Selector="Button.secondaryButton">
            <Setter Property="Background" Value="#142A3A"/>
            <Setter Property="Foreground" Value="#BFD0DB"/>
            <Setter Property="BorderBrush" Value="#294457"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style Selector="Button.secondaryButton:pointerover">
            <Setter Property="Background" Value="#1B394D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#35C978"/>
        </Style>

        <Style Selector="Button.secondaryButton:pressed">
            <Setter Property="Background" Value="#21506A"/>
        </Style>

        <Style Selector="Button.attachButton">
            <Setter Property="Background" Value="#142A3A"/>
            <Setter Property="Foreground" Value="#BFD0DB"/>
            <Setter Property="BorderBrush" Value="#294457"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <Style Selector="Button.attachButton:pointerover">
            <Setter Property="Background" Value="#1B394D"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#35C978"/>
        </Style>

        <Style Selector="Button.attachButton:pressed">
            <Setter Property="Background" Value="#21506A"/>
        </Style>

        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#0D1B28"/>
            <Setter Property="BorderBrush" Value="#1B3447"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <Style Selector="Border.sensorCard">
            <Setter Property="Background" Value="#101F2D"/>
            <Setter Property="BorderBrush" Value="#1B3447"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <Style Selector="TextBlock.dataLabel">
            <Setter Property="Foreground" Value="#637B8A"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBlock.dataValue">
            <Setter Property="Foreground" Value="#E8F0F5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

    </UserControl.Styles>

    <Grid Background="#09131F">

        <ScrollViewer
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <StackPanel
                Margin="28"
                Spacing="20">

                <Button
                    Classes="secondaryButton"
                    Content="←  Back to Dashboard"
                    Click="BackToDashboardButton_Click"
                    HorizontalAlignment="Left"/>

                <StackPanel Spacing="5">

                    <TextBlock
                        Text="SENSOR PAYLOAD MANAGEMENT"
                        Foreground="#E8F0F5"
                        FontSize="22"
                        FontWeight="SemiBold"/>

                    <TextBlock
                        Text="Register sensors, monitor telemetry, attach device files and simulate sensor payloads."
                        Foreground="#6F8797"
                        FontSize="13"/>

                </StackPanel>

                <Border
                    Classes="panel"
                    Padding="22">

                    <Grid
                        ColumnDefinitions="*,*"
                        RowDefinitions="Auto,Auto,Auto,Auto"
                        ColumnSpacing="20"
                        RowSpacing="14">

                        <TextBlock
                            Grid.Row="0"
                            Grid.ColumnSpan="2"
                            Text="DEVICE REGISTRATION"
                            Foreground="#35C978"
                            FontSize="12"
                            FontWeight="SemiBold"/>

                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="0"
                            Spacing="6">

                            <TextBlock
                                Text="MAC Address / Unique Identifier"
                                Foreground="#AFC0CC"
                                FontSize="12"/>

                            <TextBox
                                x:Name="MacAddressTextBox"
                                Watermark="AA:BB:CC:DD:EE:FF"
                                Height="40"/>

                        </StackPanel>

                        <StackPanel
                            Grid.Row="1"
                            Grid.Column="1"
                            Spacing="6">

                            <TextBlock
                                Text="Deployment Location"
                                Foreground="#AFC0CC"
                                FontSize="12"/>

                            <TextBox
                                x:Name="LocationTextBox"
                                Watermark="Room 101 / Zone A"
                                Height="40"/>

                        </StackPanel>

                        <StackPanel
                            Grid.Row="2"
                            Grid.Column="0"
                            Spacing="6">

                            <TextBlock
                                Text="Node ID"
                                Foreground="#AFC0CC"
                                FontSize="12"/>

                            <TextBox
                                x:Name="NodeIdTextBox"
                                Watermark="NODE-001"
                                Height="40"/>

                        </StackPanel>

                        <StackPanel
                            Grid.Row="2"
                            Grid.Column="1"
                            Spacing="6">

                            <TextBlock
                                Text="Sensor Category"
                                Foreground="#AFC0CC"
                                FontSize="12"/>

                            <ComboBox
                                x:Name="SensorCategoryComboBox"
                                Height="40"
                                SelectedIndex="0">

                                <ComboBoxItem Content="Environmental"/>
                                <ComboBoxItem Content="Power Consumption"/>
                                <ComboBoxItem Content="Actuator"/>

                            </ComboBox>

                        </StackPanel>

                        <StackPanel
                            Grid.Row="3"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="10"
                            Margin="0,6,0,0">

                            <Button
                                Classes="secondaryButton"
                                Content="Clear"
                                Click="ClearButton_Click"/>

                            <Button
                                Classes="primaryButton"
                                Content="Register Sensor"
                                Click="RegisterSensorButton_Click"/>

                        </StackPanel>

                    </Grid>

                </Border>

                <Border
                    Classes="panel"
                    Padding="22">

                    <StackPanel Spacing="16">

                        <Grid ColumnDefinitions="*,Auto">

                            <StackPanel
                                Grid.Column="0"
                                Spacing="3">

                                <TextBlock
                                    Text="REGISTERED SENSORS"
                                    Foreground="#E8F0F5"
                                    FontSize="15"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Text="Configured sensor registration records."
                                    Foreground="#637B8A"
                                    FontSize="11"/>

                            </StackPanel>

                            <Border
                                Grid.Column="1"
                                Background="#142A3A"
                                CornerRadius="12"
                                Padding="12,6">

                                <TextBlock
                                    x:Name="ActiveSensorsText"
                                    Text="0 ACTIVE"
                                    Foreground="#35C978"
                                    FontSize="10"
                                    FontWeight="SemiBold"/>

                            </Border>

                        </Grid>

                        <Border
                            Background="#0A1722"
                            BorderBrush="#172C3C"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12">

                            <ItemsControl
                                x:Name="RegisteredSensorsItemsControl">

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate
                                        x:DataType="models:SensorRegistration">

                                        <Border
                                            Classes="sensorCard"
                                            Padding="16"
                                            Margin="0,0,0,10">

                                            <Grid
                                                ColumnDefinitions="*,*,Auto"
                                                RowDefinitions="Auto,Auto"
                                                ColumnSpacing="20"
                                                RowSpacing="12">

                                                <StackPanel
                                                    Grid.Row="0"
                                                    Grid.Column="0"
                                                    Spacing="3">

                                                    <TextBlock
                                                        Classes="dataLabel"
                                                        Text="DEVICE"/>

                                                    <TextBlock
                                                        Classes="dataValue"
                                                        Text="{Binding MacAddress}"
                                                        TextTrimming="CharacterEllipsis"/>

                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Row="0"
                                                    Grid.Column="1"
                                                    Spacing="3">

                                                    <TextBlock
                                                        Classes="dataLabel"
                                                        Text="LOCATION"/>

                                                    <TextBlock
                                                        Classes="dataValue"
                                                        Text="{Binding Location}"
                                                        TextTrimming="CharacterEllipsis"/>

                                                </StackPanel>

                                                <Border
                                                    Grid.Row="0"
                                                    Grid.Column="2"
                                                    Background="#123D2B"
                                                    CornerRadius="10"
                                                    Padding="12,5"
                                                    VerticalAlignment="Center">

                                                    <TextBlock
                                                        Text="● ACTIVE"
                                                        Foreground="#35C978"
                                                        FontSize="10"
                                                        FontWeight="SemiBold"/>

                                                </Border>

                                                <StackPanel
                                                    Grid.Row="1"
                                                    Grid.Column="0"
                                                    Spacing="3">

                                                    <TextBlock
                                                        Classes="dataLabel"
                                                        Text="CATEGORY"/>

                                                    <TextBlock
                                                        Classes="dataValue"
                                                        Text="{Binding Category}"
                                                        TextTrimming="CharacterEllipsis"/>

                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Row="1"
                                                    Grid.Column="1"
                                                    Spacing="3">

                                                    <TextBlock
                                                        Classes="dataLabel"
                                                        Text="NODE ID"/>

                                                    <TextBlock
                                                        Classes="dataValue"
                                                        Text="{Binding NodeId}"
                                                        TextTrimming="CharacterEllipsis"/>

                                                </StackPanel>

                                                <Button
                                                    Grid.Row="1"
                                                    Grid.Column="2"
                                                    Classes="attachButton"
                                                    Content="Attach File"
                                                    Tag="{Binding}"
                                                    Click="AttachFileButton_Click"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"/>

                                            </Grid>

                                        </Border>

                                    </DataTemplate>

                                </ItemsControl.ItemTemplate>

                            </ItemsControl>

                        </Border>

                    </StackPanel>

                </Border>

                <Border
                    Classes="panel"
                    Padding="22">

                    <StackPanel Spacing="16">

                        <Grid ColumnDefinitions="*,Auto">

                            <StackPanel
                                Grid.Column="0"
                                Spacing="3">

                                <TextBlock
                                    Text="LATEST SENSOR TELEMETRY"
                                    Foreground="#E8F0F5"
                                    FontSize="15"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Text="Most recently received payload from the Smart X API."
                                    Foreground="#637B8A"
                                    FontSize="11"/>

                            </StackPanel>

                            <Border
                                Grid.Column="1"
                                Background="#142A3A"
                                CornerRadius="12"
                                Padding="12,6">

                                <TextBlock
                                    x:Name="TelemetryStatusText"
                                    Text="NO DATA"
                                    Foreground="#6F8797"
                                    FontSize="10"
                                    FontWeight="SemiBold"/>

                            </Border>

                        </Grid>

                        <Grid
                            ColumnDefinitions="*,*,*,*"
                            RowDefinitions="Auto,Auto"
                            ColumnSpacing="16"
                            RowSpacing="12">

                            <Border
                                Grid.Row="0"
                                Grid.Column="0"
                                Background="#101F2D"
                                CornerRadius="6"
                                Padding="14">

                                <StackPanel Spacing="5">

                                    <TextBlock
                                        Classes="dataLabel"
                                        Text="DEVICE ID"/>

                                    <TextBlock
                                        x:Name="TelemetryDeviceIdText"
                                        Classes="dataValue"
                                        Text="—"
                                        TextTrimming="CharacterEllipsis"/>

                                </StackPanel>

                            </Border>

                            <Border
                                Grid.Row="0"
                                Grid.Column="1"
                                Background="#101F2D"
                                CornerRadius="6"
                                Padding="14">

                                <StackPanel Spacing="5">

                                    <TextBlock
                                        Classes="dataLabel"
                                        Text="CATEGORY"/>

                                    <TextBlock
                                        x:Name="TelemetryCategoryText"
                                        Classes="dataValue"
                                        Text="—"
                                        TextTrimming="CharacterEllipsis"/>

                                </StackPanel>

                            </Border>

                            <Border
                                Grid.Row="0"
                                Grid.Column="2"
                                Background="#101F2D"
                                BorderBrush="#207A4A"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14">

                                <StackPanel Spacing="5">

                                    <TextBlock
                                        Classes="dataLabel"
                                        Text="VALUE"/>

                                    <TextBlock
                                        x:Name="TelemetryValueText"
                                        Text="—"
                                        Foreground="#35C978"
                                        FontSize="20"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis"/>

                                </StackPanel>

                            </Border>

                            <Border
                                Grid.Row="0"
                                Grid.Column="3"
                                Background="#101F2D"
                                CornerRadius="6"
                                Padding="14">

                                <StackPanel Spacing="5">

                                    <TextBlock
                                        Classes="dataLabel"
                                        Text="TIMESTAMP"/>

                                    <TextBlock
                                        x:Name="TelemetryTimestampText"
                                        Classes="dataValue"
                                        Text="—"
                                        TextTrimming="CharacterEllipsis"/>

                                </StackPanel>

                            </Border>

                            <Border
                                Grid.Row="1"
                                Grid.ColumnSpan="4"
                                Background="#101F2D"
                                CornerRadius="6"
                                Padding="14">

                                <StackPanel Spacing="5">

                                    <TextBlock
                                        Classes="dataLabel"
                                        Text="API ENDPOINT"/>

                                    <TextBlock
                                        x:Name="TelemetryEndpointText"
                                        Classes="dataValue"
                                        Text="—"
                                        TextTrimming="CharacterEllipsis"/>

                                </StackPanel>

                            </Border>

                        </Grid>

                    </StackPanel>

                </Border>

                <Border
                    Classes="panel"
                    Padding="22">

                    <Grid
                        ColumnDefinitions="*,Auto"
                        ColumnSpacing="25">

                        <StackPanel
                            Grid.Column="0"
                            Spacing="6">

                            <TextBlock
                                Text="PAYLOAD SIMULATION"
                                Foreground="#E8F0F5"
                                FontSize="15"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Text="Generate a test telemetry payload using a registered sensor."
                                Foreground="#637B8A"
                                FontSize="11"/>

                            <ComboBox
                                x:Name="SimulationSensorComboBox"
                                Width="280"
                                Height="40"
                                Margin="0,8,0,0"
                                IsEnabled="False"/>

                        </StackPanel>

                        <Button
                            x:Name="SimulatePayloadButton"
                            Grid.Column="1"
                            Classes="primaryButton"
                            Content="Simulate Payload"
                            VerticalAlignment="Center"
                            IsEnabled="False"
                            Click="SimulatePayloadButton_Click"/>

                    </Grid>

                </Border>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>