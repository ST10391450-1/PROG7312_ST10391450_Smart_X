<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Smart_X_UI.Pages.AddLocation">

    <UserControl.Styles>

        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#AFC3D4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#101F2D"/>
            <Setter Property="Foreground" Value="#E7F0F7"/>
            <Setter Property="BorderBrush" Value="#29445A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#101F2D"/>
            <Setter Property="Foreground" Value="#E7F0F7"/>
            <Setter Property="BorderBrush" Value="#29445A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="#1B3042"/>
            <Setter Property="Foreground" Value="#D8E6F3"/>
            <Setter Property="Padding" Value="16,10"/>
        </Style>

        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2D8CFF"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Button.back">
            <Setter Property="Background" Value="#162636"/>
            <Setter Property="Foreground" Value="#AFC3D4"/>
        </Style>

    </UserControl.Styles>

    <Grid
        RowDefinitions="Auto,*"
        Background="#0B1722">

        <Border
            Grid.Row="0"
            Background="#101F2D"
            BorderBrush="#233B50"
            BorderThickness="0,0,0,1"
            Padding="28,22">

            <Grid ColumnDefinitions="*,Auto">

                <StackPanel Spacing="5">

                    <TextBlock
                        Text="ADD LOCATION"
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="#F1F6FA"/>

                    <TextBlock
                        Text="Create a deployment location for Smart X sensors."
                        FontSize="13"
                        Foreground="#8FA6B8"/>

                </StackPanel>

                <Button
                    Grid.Column="1"
                    Content="←  Back"
                    Classes="back"
                    Click="BackButton_Click"/>

            </Grid>

        </Border>

        <ScrollViewer
            Grid.Row="1"
            Padding="28"
            HorizontalScrollBarVisibility="Disabled">

            <Border
                MaxWidth="720"
                HorizontalAlignment="Center"
                Background="#162636"
                BorderBrush="#233B50"
                BorderThickness="1"
                CornerRadius="12"
                Padding="28">

                <StackPanel Spacing="22">

                    <StackPanel Spacing="5">

                        <TextBlock
                            Text="LOCATION DETAILS"
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="#F1F6FA"/>

                        <TextBlock
                            Text="Define where sensors will be deployed."
                            FontSize="13"
                            Foreground="#8FA6B8"/>

                    </StackPanel>

                    <StackPanel Spacing="7">

                        <TextBlock
                            Text="PARENT LOCATION"
                            Classes="label"/>

                        <ComboBox
                            x:Name="ParentLocationComboBox"
                            PlaceholderText="Select a parent location"/>

                        <TextBlock
                            Text="Leave this empty to create a top-level location."
                            FontSize="11"
                            Foreground="#71899B"
                            TextWrapping="Wrap"/>

                    </StackPanel>

                    <StackPanel Spacing="7">

                        <TextBlock
                            Text="LOCATION NAME"
                            Classes="label"/>

                        <TextBox
                            x:Name="LocationNameTextBox"
                            PlaceholderText="e.g. Server Room"
                            TextChanged="LocationNameTextBox_TextChanged"/>

                        <TextBlock
                            x:Name="LocationNameErrorText"
                            Text="Location name is required."
                            Foreground="#FF6B6B"
                            FontSize="12"
                            IsVisible="False"/>

                    </StackPanel>

                    <Border
                        Background="#101F2D"
                        BorderBrush="#29445A"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">

                        <StackPanel Spacing="7">

                            <TextBlock
                                Text="LOCATION PREVIEW"
                                Classes="label"/>

                            <TextBlock
                                x:Name="LocationPreviewText"
                                Text="New location"
                                Foreground="#8FC5FF"
                                FontSize="15"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"/>

                        </StackPanel>

                    </Border>

                    <Border
                        x:Name="StatusBorder"
                        Background="#102A38"
                        BorderBrush="#24536A"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        IsVisible="False">

                        <TextBlock
                            x:Name="StatusText"
                            Foreground="#8FC5FF"
                            FontSize="13"
                            TextWrapping="Wrap"/>

                    </Border>

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12">

                        <Button
                            Content="Clear"
                            Click="ClearButton_Click"/>

                        <Button
                            Grid.Column="1"
                            x:Name="AddLocationButton"
                            Content="Add Location"
                            Classes="primary"
                            Click="AddLocationButton_Click"/>

                    </Grid>

                </StackPanel>

            </Border>

        </ScrollViewer>

    </Grid>

</UserControl>