
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Smart_X_UI.Pages.NetworkTopologyView"
    x:CompileBindings="False">

    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#DCE7ED"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="#1B394A"/>
            <Setter Property="Foreground" Value="#DCE7ED"/>
            <Setter Property="BorderBrush" Value="#31566B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#28536A"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="#0B1722"/>
            <Setter Property="Foreground" Value="#DCE7ED"/>
            <Setter Property="BorderBrush" Value="#31566B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <StackPanel Margin="24" Spacing="20">

            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="14">

                <Button Grid.Column="0"
                        Content="← Back"
                        VerticalAlignment="Center"
                        Click="Back_Click"/>

                <StackPanel Grid.Column="1"
                            Spacing="5"
                            VerticalAlignment="Center">

                    <TextBlock Text="Network Topology"
                               FontSize="26"
                               FontWeight="Bold"/>

                    <TextBlock Text="Physical network monitoring, virtual mesh simulation and routing analysis"
                               Foreground="#8FA7B8"
                               FontSize="13"/>
                </StackPanel>

                <Button Grid.Column="2"
                        Content="Refresh"
                        VerticalAlignment="Center"
                        Click="RefreshTopology_Click"/>
            </Grid>

            <Border Background="#102432"
                    BorderBrush="#254253"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="14">

                <Grid ColumnDefinitions="*,Auto">

                    <StackPanel Spacing="5">
                        <TextBlock x:Name="ApiStatusText"
                                   Text="Waiting for API connection"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>

                        <TextBlock x:Name="LastUpdatedText"
                                   Text="Topology has not been retrieved yet"
                                   Foreground="#8FA7B8"
                                   FontSize="11"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#173C3A"
                            CornerRadius="6"
                            Padding="10,6"
                            VerticalAlignment="Center">

                        <TextBlock Text="API"
                                   Foreground="#72D6B4"
                                   FontWeight="SemiBold"
                                   FontSize="11"/>
                    </Border>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="14">

                <Border Background="#102432"
                        BorderBrush="#254253"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="16">

                    <StackPanel Spacing="8">
                        <TextBlock Text="REGISTERED NODES"
                                   Foreground="#8FA7B8"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="RegisteredNodesValue"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Background="#102432"
                        BorderBrush="#254253"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="16">

                    <StackPanel Spacing="8">
                        <TextBlock Text="CONNECTED NODES"
                                   Foreground="#8FA7B8"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="ConnectedNodesValue"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#72D6B4"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Background="#102432"
                        BorderBrush="#254253"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="16">

                    <StackPanel Spacing="8">
                        <TextBlock Text="DISCONNECTED NODES"
                                   Foreground="#8FA7B8"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="DisconnectedNodesValue"
                                   Text="0"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="#E5A27F"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Background="#102432"
                    BorderBrush="#254253"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="18">

                <StackPanel Spacing="14">

                    <StackPanel Spacing="4">
                        <TextBlock Text="Physical Network Nodes"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Registered physical sensors and their reported connectivity"
                                   Foreground="#8FA7B8"
                                   FontSize="12"/>
                    </StackPanel>

                    <Border Background="#254253" Height="1"/>

                    <TextBlock x:Name="NodesEmptyText"
                               Text="No network nodes loaded."
                               Foreground="#8FA7B8"
                               FontSize="12"
                               TextWrapping="Wrap"/>

                    <ScrollViewer MaxHeight="300"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <ItemsControl x:Name="NodesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="{x:Null}">
                                    <Border Background="#132B3B"
                                            BorderBrush="#254253"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="14"
                                            Margin="0,0,0,9">

                                        <Grid ColumnDefinitions="*,Auto"
                                              RowDefinitions="Auto,Auto,Auto,Auto">

                                            <TextBlock Grid.Row="0"
                                                       Text="{Binding Name}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"/>

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding NodeId}"
                                                       Foreground="#8FA7B8"
                                                       FontSize="11"
                                                       Margin="0,5,0,0"/>

                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding MacAddress}"
                                                       Foreground="#8FA7B8"
                                                       FontSize="11"
                                                       Margin="0,5,0,0"/>

                                            <TextBlock Grid.Row="3"
                                                       Text="{Binding Location}"
                                                       Foreground="#8FA7B8"
                                                       FontSize="11"
                                                       Margin="0,5,0,0"/>

                                            <Border Grid.Column="1"
                                                    Grid.Row="0"
                                                    Grid.RowSpan="2"
                                                    Background="#173C3A"
                                                    CornerRadius="5"
                                                    Padding="9,5"
                                                    VerticalAlignment="Center">

                                                <TextBlock Text="{Binding IsOnline}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"/>
                                            </Border>

                                            <TextBlock Grid.Column="1"
                                                       Grid.Row="2"
                                                       Grid.RowSpan="2"
                                                       Text="{Binding LastSeenAt}"
                                                       Foreground="#8FA7B8"
                                                       FontSize="10"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Background="#102432"
                    BorderBrush="#254253"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="18">

                <StackPanel Spacing="14">

                    <StackPanel Spacing="4">
                        <TextBlock Text="Physical Network Connections"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Recorded links and their transmission characteristics"
                                   Foreground="#8FA7B8"
                                   FontSize="12"/>
                    </StackPanel>

                    <Border Background="#254253" Height="1"/>

                    <TextBlock x:Name="ConnectionsEmptyText"
                               Text="No recorded network connections."
                               Foreground="#8FA7B8"
                               FontSize="12"
                               TextWrapping="Wrap"/>

                    <ScrollViewer MaxHeight="250"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <ItemsControl x:Name="ConnectionsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="{x:Null}">
                                    <Border Background="#132B3B"
                                            BorderBrush="#254253"
                                            BorderThickness="1"
                                            CornerRadius="7"
                                            Padding="14"
                                            Margin="0,0,0,9">

                                        <Grid ColumnDefinitions="*,Auto"
                                              RowDefinitions="Auto,Auto,Auto">

                                            <TextBlock Grid.Row="0"
                                                       Text="{Binding SourceNodeId}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"/>

                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding DestinationNodeId}"
                                                       Foreground="#8FA7B8"
                                                       FontSize="12"
                                                       Margin="0,5,0,0"/>

                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding SignalStrength, StringFormat='Signal strength: {0}'}"
                                                       Foreground="#8FA7B8"
                                                       FontSize="11"
                                                       Margin="0,7,0,0"/>

                                            <TextBlock Grid.Column="1"
                                                       Grid.Row="0"
                                                       Grid.RowSpan="3"
                                                       Text="{Binding TransmissionPowerCost, StringFormat='Power cost: {0}'}"
                                                       Foreground="#72D6B4"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Margin="12,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Background="#102432"
                    BorderBrush="#254253"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="18">

                <StackPanel Spacing="14">

                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Virtual Network Simulation"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                            <Border Grid.Column="1"
                                    Background="#173C3A"
                                    CornerRadius="5"
                                    Padding="9,5">

                                <TextBlock Text="LIVE SIMULATION"
                                           Foreground="#72D6B4"
                                           FontSize="9"
                                           FontWeight="Bold"/>
                            </Border>
                        </Grid>

                        <TextBlock Text="Independent virtual mesh network with simulated node movement, connection range and signal strength"
                                   Foreground="#8FA7B8"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Background="#254253" Height="1"/>

                    <Grid ColumnDefinitions="*,*,*"
                          ColumnSpacing="10">

                        <Border Background="#132B3B"
                                CornerRadius="7"
                                Padding="12">

                            <StackPanel Spacing="6">
                                <TextBlock Text="TOTAL NODES"
                                           Foreground="#8FA7B8"
                                           FontSize="10"/>

                                <TextBlock x:Name="SimulationTotalNodesValue"
                                           Text="0"
                                           FontSize="23"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Background="#132B3B"
                                CornerRadius="7"
                                Padding="12">

                            <StackPanel Spacing="6">
                                <TextBlock Text="ONLINE"
                                           Foreground="#8FA7B8"
                                           FontSize="10"/>

                                <TextBlock x:Name="SimulationOnlineNodesValue"
                                           Text="0"
                                           FontSize="23"
                                           FontWeight="Bold"
                                           Foreground="#72D6B4"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="#132B3B"
                                CornerRadius="7"
                                Padding="12">

                            <StackPanel Spacing="6">
                                <TextBlock Text="OFFLINE"
                                           Foreground="#8FA7B8"
                                           FontSize="10"/>

                                <TextBlock x:Name="SimulationOfflineNodesValue"
                                           Text="0"
                                           FontSize="23"
                                           FontWeight="Bold"
                                           Foreground="#E5A27F"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="SimulationStatusText"
                                   Text="Waiting for simulation data"
                                   Foreground="#8FA7B8"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="SimulationUpdatedText"
                                   Grid.Column="1"
                                   Text="Not updated"
                                   Foreground="#607D8D"
                                   FontSize="10"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Border Background="#0B1722"
                            BorderBrush="#254253"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">

                        <StackPanel Spacing="10">

                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Live Mesh Topology"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>

                                    <TextBlock Text="500m × 500m simulated network area"
                                               Foreground="#8FA7B8"
                                               FontSize="10"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="METRES"
                                           Foreground="#607D8D"
                                           FontSize="9"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <TextBlock x:Name="SimulationGraphStatusText"
                                       Text="Waiting for graph data..."
                                       Foreground="#8FA7B8"
                                       FontSize="11"/>

                            <Border Background="#102432"
                                    BorderBrush="#254253"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="4">

                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Auto"
                                              MaxHeight="470">

                                    <Canvas x:Name="SimulationMapCanvas"
                                            Width="700"
                                            Height="460"
                                            Background="#0B1722"/>
                                </ScrollViewer>
                            </Border>

                            <Border Background="#254253" Height="1"/>

                            <WrapPanel Orientation="Horizontal">

                                <StackPanel Orientation="Horizontal"
                                            Spacing="5"
                                            Margin="0,0,18,6">
                                    <Ellipse Width="10"
                                             Height="10"
                                             Fill="#72D6B4"/>
                                    <TextBlock Text="Online node"
                                               Foreground="#8FA7B8"
                                               FontSize="10"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Spacing="5"
                                            Margin="0,0,18,6">
                                    <Ellipse Width="10"
                                             Height="10"
                                             Fill="#E5A27F"/>
                                    <TextBlock Text="Offline node"
                                               Foreground="#8FA7B8"
                                               FontSize="10"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Spacing="5"
                                            Margin="0,0,18,6">
                                    <Rectangle Width="18"
                                               Height="3"
                                               Fill="#72D6B4"/>
                                    <TextBlock Text="Strong signal"
                                               Foreground="#8FA7B8"
                                               FontSize="10"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Spacing="5"
                                            Margin="0,0,18,6">
                                    <Rectangle Width="18"
                                               Height="3"
                                               Fill="#E5C17B"/>
                                    <TextBlock Text="Medium signal"
                                               Foreground="#8FA7B8"
                                               FontSize="10"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Spacing="5"
                                            Margin="0,0,18,6">
                                    <Rectangle Width="18"
                                               Height="3"
                                               Fill="#E5A27F"/>
                                    <TextBlock Text="Weak signal"
                                               Foreground="#8FA7B8"
                                               FontSize="10"/>
                                </StackPanel>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Simulated Nodes"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="SimulationNodesEmptyText"
                                   Text="No simulated nodes available."
                                   Foreground="#8FA7B8"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>

                        <ScrollViewer MaxHeight="200"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">

                            <ItemsControl x:Name="SimulationNodesList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="{x:Null}">
                                        <Border Background="#132B3B"
                                                BorderBrush="#254253"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="12"
                                                Margin="0,0,0,7">

                                            <Grid ColumnDefinitions="*,Auto"
                                                  RowDefinitions="Auto,Auto">

                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"/>

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding NodeId}"
                                                           Foreground="#8FA7B8"
                                                           FontSize="10"
                                                           Margin="0,4,0,0"/>

                                                <Border Grid.Column="1"
                                                        Grid.RowSpan="2"
                                                        Background="#173C3A"
                                                        CornerRadius="5"
                                                        Padding="8,5"
                                                        VerticalAlignment="Center">

                                                    <TextBlock Text="{Binding Status}"
                                                               FontSize="9"
                                                               FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Simulated Connections"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="SimulationConnectionsEmptyText"
                                   Text="No simulated connections available."
                                   Foreground="#8FA7B8"
                                   FontSize="11"
                                   TextWrapping="Wrap"/>

                        <ScrollViewer MaxHeight="260"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">

                            <ItemsControl x:Name="SimulationConnectionsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="{x:Null}">
                                        <Border Background="#132B3B"
                                                BorderBrush="#254253"
                                                BorderThickness="1"
                                                CornerRadius="7"
                                                Padding="12"
                                                Margin="0,0,0,7">

                                            <Grid ColumnDefinitions="*,Auto"
                                                  RowDefinitions="Auto,Auto,Auto">

                                                <TextBlock Text="{Binding SourceNodeId}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"/>

                                                <TextBlock Grid.Row="1"
                                                           Text="{Binding DestinationNodeId}"
                                                           Foreground="#8FA7B8"
                                                           FontSize="11"
                                                           Margin="0,4,0,0"/>

                                                <TextBlock Grid.Row="2"
                                                           Text="{Binding DistanceMeters, StringFormat='Distance: {0} m'}"
                                                           Foreground="#8FA7B8"
                                                           FontSize="10"
                                                           Margin="0,6,0,0"/>

                                                <StackPanel Grid.Column="1"
                                                            Grid.RowSpan="3"
                                                            Spacing="5"
                                                            VerticalAlignment="Center">

                                                    <TextBlock Text="{Binding SignalStrength, StringFormat='Signal: {0}%'}"
                                                               Foreground="#72D6B4"
                                                               FontSize="10"/>

                                                    <TextBlock Text="{Binding TransmissionPowerCost, StringFormat='Power: {0}'}"
                                                               Foreground="#8FA7B8"
                                                               FontSize="10"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#102432"
                    BorderBrush="#254253"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="18">

                <StackPanel Spacing="14">

                    <StackPanel Spacing="4">
                        <TextBlock Text="Minimum Spanning Tree"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Calculate a power-efficient network structure using connection costs and signal strength."
                                   Foreground="#8FA7B8"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button Content="Calculate Minimum Spanning Tree"
                            Click="CalculateMst_Click"/>

                    <Grid ColumnDefinitions="*,*,*"
                          ColumnSpacing="10">

                        <Border Background="#132B3B"
                                CornerRadius="7"
                                Padding="12">

                            <StackPanel Spacing="6">
                                <TextBlock Text="TOTAL COST"
                                           Foreground="#8FA7B8"
                                           FontSize="10"/>

                                <TextBlock x:Name="TotalNetworkCostValue"
                                           Text="--"
                                           FontSize="19"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Background="#132B3B"
                                CornerRadius="7"
                                Padding="12">

                            <StackPanel Spacing="6">
                                <TextBlock Text="SELECTED EDGES"
                                           Foreground="#8FA7B8"
                                           FontSize="10"/>

                                <TextBlock x:Name="SelectedConnectionsValue"
                                           Text="--"
                                           FontSize="19"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="#132B3B"
                                CornerRadius="7"
                                Padding="12">

                            <StackPanel Spacing="6">
                                <TextBlock Text="COMPONENTS"
                                           Foreground="#8FA7B8"
                                           FontSize="10"/>

                                <TextBlock x:Name="ConnectedComponentsValue"
                                           Text="--"
                                           FontSize="19"
                                           FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Background="#0B1722"
                            BorderBrush="#254253"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="14">

                        <StackPanel Spacing="8">
                            <TextBlock Text="MST Results"
                                       FontWeight="SemiBold"
                                       FontSize="13"/>

                            <TextBlock x:Name="MstStatusText"
                                       Text="Awaiting API calculation."
                                       Foreground="#8FA7B8"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                            <Border Background="#254253" Height="1"/>

                            <TextBlock Text="Selected Connections"
                                       FontWeight="SemiBold"
                                       FontSize="12"/>

                            <TextBlock x:Name="MstEdgesText"
                                       Text="No MST results available."
                                       Foreground="#8FA7B8"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Background="#102432"
                    BorderBrush="#254253"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="18">

                <StackPanel Spacing="14">

                    <StackPanel Spacing="4">
                        <TextBlock Text="Shortest Path Routing"
                                   FontSize="18"
                                   FontWeight="Bold"/>

                        <TextBlock Text="Find the lowest-cost route between two registered network nodes."
                                   Foreground="#8FA7B8"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*"
                          ColumnSpacing="12">

                        <StackPanel Spacing="6">
                            <TextBlock Text="Starting Node ID"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>

                            <TextBox x:Name="StartNodeIdTextBox"
                                     PlaceholderText="Enter starting node ID"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Spacing="6">

                            <TextBlock Text="Destination Node ID"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>

                            <TextBox x:Name="DestinationNodeIdTextBox"
                                     PlaceholderText="Enter destination node ID"/>
                        </StackPanel>
                    </Grid>

                    <Button Content="Find Most Efficient Path"
                            Click="FindShortestPath_Click"/>

                    <Border Background="#0B1722"
                            BorderBrush="#254253"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="14">

                        <StackPanel Spacing="8">
                            <TextBlock Text="Routing Results"
                                       FontWeight="SemiBold"
                                       FontSize="13"/>

                            <TextBlock x:Name="ShortestPathResultsText"
                                       Text="Shortest path results will appear here."
                                       Foreground="#8FA7B8"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="Smart X | Network Topology and Routing"
                       Foreground="#607D8D"
                       FontSize="10"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,12"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>
