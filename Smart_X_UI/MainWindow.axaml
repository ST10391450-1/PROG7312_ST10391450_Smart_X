<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Smart_X_UI.Controls"
    x:Class="Smart_X_UI.MainWindow"
    WindowDecorations="None"
    Width="650"
    Height="1000"
    Background="#09131F"
    CanResize="True"
    CanMaximize="False"
    MinWidth="520"
    MinHeight="700">

    <Window.Styles>

        <Style Selector="Button">
            <Setter Property="Background" Value="#102235"/>
            <Setter Property="Foreground" Value="#DCE7ED"/>
            <Setter Property="BorderBrush" Value="#1E3A4F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,12"/>
        </Style>

        <Style Selector="Button:pointerover">
            <Setter Property="Background" Value="#153149"/>
            <Setter Property="BorderBrush" Value="#35B86B"/>
        </Style>

        <Style Selector="Button:pressed">
            <Setter Property="Background" Value="#1A4052"/>
        </Style>

        <Style Selector="Button:disabled">
            <Setter Property="Background" Value="#0C1926"/>
            <Setter Property="Foreground" Value="#526777"/>
            <Setter Property="BorderBrush" Value="#162A3A"/>
        </Style>

    </Window.Styles>

    <Grid RowDefinitions="38,*">

        <!-- Custom title bar -->
        <controls:TitleBar Grid.Row="0"/>

        <ContentControl
            x:Name="MainContent"
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch">

            <ScrollViewer
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

                <StackPanel
                    Margin="28"
                    Spacing="24">

                    <!-- ================================================= -->
                    <!-- HEADER / SYSTEM STATUS -->
                    <!-- ================================================= -->

                    <Border
                        Background="#0B1826"
                        Padding="28,28,28,22">

                        <Grid RowDefinitions="Auto,Auto,Auto">

                            <StackPanel
                                Grid.Row="0"
                                Spacing="6">

                                <TextBlock
                                    Text="Smart X"
                                    FontSize="30"
                                    FontWeight="Bold"
                                    Foreground="#F0F6F9"/>

                                <TextBlock
                                    Text="System Control Interface"
                                    FontSize="13"
                                    Foreground="#70899B"/>

                            </StackPanel>

                            <!-- Dynamic system/API status -->

                            <Grid
                                Grid.Row="1"
                                Margin="0,22,0,0"
                                ColumnDefinitions="Auto,*,Auto">

                                <Border
                                    Grid.Column="0"
                                    Width="10"
                                    Height="10"
                                    CornerRadius="5"
                                    Background="#102B2A"
                                    VerticalAlignment="Center">

                                    <Ellipse
                                        x:Name="SystemStatusIndicator"
                                        Width="10"
                                        Height="10"
                                        Fill="#D6A84F"/>

                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    Spacing="2">

                                    <TextBlock
                                        x:Name="SystemStatusText"
                                        Text="CHECKING..."
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="#D6A84F"/>

                                    <TextBlock
                                        x:Name="SystemStatusDescriptionText"
                                        Text="Checking Smart X API..."
                                        FontSize="11"
                                        Foreground="#617A8B"
                                        TextWrapping="Wrap"/>

                                </StackPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="LOCAL"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#4D6677"
                                    VerticalAlignment="Center"/>

                            </Grid>

                            <Border
                                Grid.Row="2"
                                Height="1"
                                Margin="0,22,0,0"
                                Background="#193044"/>

                        </Grid>

                    </Border>

                    <!-- ================================================= -->
                    <!-- SYSTEM MODULES -->
                    <!-- ================================================= -->

                    <StackPanel Spacing="12">

                        <Grid ColumnDefinitions="*,Auto">

                            <StackPanel
                                Grid.Column="0"
                                Spacing="3">

                                <TextBlock
                                    Text="SYSTEM MODULES"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="#35B86B"/>

                                <TextBlock
                                    Text="Available control and data services"
                                    FontSize="11"
                                    Foreground="#536C7D"/>

                            </StackPanel>

                            <Border
                                Grid.Column="1"
                                Background="#102B2A"
                                CornerRadius="5"
                                Padding="9,5"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Text="1 ACTIVE"
                                    FontSize="9"
                                    FontWeight="Bold"
                                    Foreground="#35B86B"/>

                            </Border>

                        </Grid>

                        <!-- Sensor module -->

                        <Button
                            x:Name="SensorDataButton"
                            Click="SensorDataButton_Click"
                            HorizontalContentAlignment="Stretch"
                            MinHeight="86">

                            <Grid ColumnDefinitions="Auto,*,Auto">

                                <Border
                                    Grid.Column="0"
                                    Width="46"
                                    Height="46"
                                    CornerRadius="8"
                                    Background="#102E2A"
                                    Margin="0,0,16,0">

                                    <TextBlock
                                        Text="S"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="19"
                                        FontWeight="Bold"
                                        Foreground="#35C978"/>

                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="5">

                                    <TextBlock
                                        Text="Sensor Data Ingestion"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="#E8F0F5"/>

                                    <TextBlock
                                        Text="Collect and process sensor data"
                                        FontSize="11"
                                        Foreground="#70899B"/>

                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Spacing="6">

                                    <TextBlock
                                        Text="AVAILABLE"
                                        FontSize="9"
                                        FontWeight="Bold"
                                        Foreground="#35B86B"
                                        HorizontalAlignment="Right"/>

                                    <Ellipse
                                        Width="7"
                                        Height="7"
                                        Fill="#35B86B"
                                        HorizontalAlignment="Right"/>

                                </StackPanel>

                            </Grid>

                        </Button>

                        <!-- Command stream -->

                        <Button
                            IsEnabled="False"
                            HorizontalContentAlignment="Stretch"
                            MinHeight="86">

                            <Grid ColumnDefinitions="Auto,*,Auto">

                                <Border
                                    Grid.Column="0"
                                    Width="46"
                                    Height="46"
                                    CornerRadius="8"
                                    Background="#101C28"
                                    Margin="0,0,16,0">

                                    <TextBlock
                                        Text="C"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="19"
                                        FontWeight="Bold"
                                        Foreground="#4E6474"/>

                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="5">

                                    <TextBlock
                                        Text="Real-Time Command Stream"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="#526777"/>

                                    <TextBlock
                                        Text="Send commands to connected devices"
                                        FontSize="11"
                                        Foreground="#526777"/>

                                </StackPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="UNAVAILABLE"
                                    FontSize="9"
                                    FontWeight="Bold"
                                    Foreground="#506575"
                                    VerticalAlignment="Center"/>

                            </Grid>

                        </Button>

                        <!-- Network topology -->

                        <Button
                            IsEnabled="False"
                            HorizontalContentAlignment="Stretch"
                            MinHeight="86">

                            <Grid ColumnDefinitions="Auto,*,Auto">

                                <Border
                                    Grid.Column="0"
                                    Width="46"
                                    Height="46"
                                    CornerRadius="8"
                                    Background="#101C28"
                                    Margin="0,0,16,0">

                                    <TextBlock
                                        Text="N"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="19"
                                        FontWeight="Bold"
                                        Foreground="#4E6474"/>

                                </Border>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="5">

                                    <TextBlock
                                        Text="Network Topology and Mesh Routing"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="#526777"/>

                                    <TextBlock
                                        Text="Manage connected nodes and routing"
                                        FontSize="11"
                                        Foreground="#526777"/>

                                </StackPanel>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="UNAVAILABLE"
                                    FontSize="9"
                                    FontWeight="Bold"
                                    Foreground="#506575"
                                    VerticalAlignment="Center"/>

                            </Grid>

                        </Button>

                    </StackPanel>

                    <!-- ================================================= -->
                    <!-- API CONNECTION -->
                    <!-- ================================================= -->

                    <StackPanel Spacing="12">

                        <TextBlock
                            Text="CONNECTION"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="#35B86B"/>

                        <Border
                            Background="#0D1D2B"
                            BorderBrush="#193447"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="18">

                            <Grid RowDefinitions="Auto,Auto,Auto">

                                <!-- Connection status -->

                                <Grid
                                    Grid.Row="0"
                                    ColumnDefinitions="Auto,*,Auto">

                                    <Border
                                        Width="34"
                                        Height="34"
                                        CornerRadius="7"
                                        Background="#102B2A">

                                        <Ellipse
                                            x:Name="ApiConnectionIndicator"
                                            Width="9"
                                            Height="9"
                                            Fill="#D6A84F"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Spacing="3">

                                        <TextBlock
                                            Text="Local API"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="#E8F0F5"/>

                                        <TextBlock
                                            Text="Smart X backend service"
                                            FontSize="10"
                                            Foreground="#637C8D"/>

                                    </StackPanel>

                                    <TextBlock
                                        x:Name="ApiConnectionStatusText"
                                        Grid.Column="2"
                                        Text="CHECKING..."
                                        FontSize="9"
                                        FontWeight="Bold"
                                        Foreground="#D6A84F"
                                        VerticalAlignment="Center"/>

                                </Grid>

                                <Border
                                    Grid.Row="1"
                                    Height="1"
                                    Margin="0,16,0,14"
                                    Background="#193447"/>

                                <!-- API information -->

                                <Grid
                                    Grid.Row="2"
                                    ColumnDefinitions="*,*">

                                    <StackPanel
                                        Grid.Column="0"
                                        Spacing="3">

                                        <TextBlock
                                            Text="STATUS"
                                            FontSize="9"
                                            FontWeight="Bold"
                                            Foreground="#4F6879"/>

                                        <TextBlock
                                            x:Name="ApiStatusText"
                                            Text="Checking..."
                                            FontSize="12"
                                            Foreground="#B9CAD4"
                                            TextWrapping="Wrap"/>

                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="1"
                                        Spacing="3">

                                        <TextBlock
                                            Text="MODE"
                                            FontSize="9"
                                            FontWeight="Bold"
                                            Foreground="#4F6879"/>

                                        <TextBlock
                                            x:Name="ApiModeText"
                                            Text="Local"
                                            FontSize="12"
                                            Foreground="#B9CAD4"/>

                                    </StackPanel>

                                </Grid>

                            </Grid>

                        </Border>

                    </StackPanel>

                    <!-- ================================================= -->
                    <!-- FOOTER -->
                    <!-- ================================================= -->

                    <Border
                        Height="1"
                        Background="#193044"/>

                    <StackPanel
                        HorizontalAlignment="Center"
                        Spacing="4">

                        <TextBlock
                            Text="SMART X"
                            HorizontalAlignment="Center"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="#40596A"/>

                        <TextBlock
                            Text="System Control Interface"
                            HorizontalAlignment="Center"
                            FontSize="9"
                            Foreground="#304858"/>

                    </StackPanel>

                </StackPanel>

            </ScrollViewer>

        </ContentControl>

    </Grid>

</Window>